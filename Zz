-- กดซ่อนเมนู (กด - บนแถบ) -> ย่อไปเป็นปุ่มเปิดโปร
MinimizeBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
    OpenBtn.Visible = true
end)

-- กดปุ่ม "เปิดโปร" -> แสดงหน้าต่างหลัก
OpenBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = true
    OpenBtn.Visible = false
end)

-- กดปิด/ออกโปร (กด X บนแถบ) -> ทำลาย GUI และปิดการทำงาน
CloseBtn.MouseButton1Click:Connect(function()
    AimEnabled = false
    ScreenGui:Destroy()
end)

-- กดเปิด/ปิด ระบบ AimLock
ToggleBtn.MouseButton1Click:Connect(function()
    AimEnabled = not AimEnabled
    if AimEnabled then
        ToggleBtn.Text = "สคริปต์: เปิดอยู่ [ON]"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
    else
        ToggleBtn.Text = "สคริปต์: ปิดอยู่ [OFF]"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

-- กดสลับจุดล็อก Head / Body
PartBtn.MouseButton1Click:Connect(function()
    if AimPart == "Head" then
        AimPart = "HumanoidRootPart"
        PartBtn.Text = "จุดล็อก: ลำตัว (Body)"
    else
        AimPart = "Head"
        PartBtn.Text = "จุดล็อก: หัว (Head)"
    end
end)

-- ค้นหาผู้เล่นที่ใกล้เป้าเล็งที่สุด
local function GetClosestPlayer()
    local ClosestPlayer = nil
    local ShortestDistance = math.huge
    local MousePos = UserInputService:GetMouseLocation()

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild(AimPart) and v.Character:FindFirstChildOfClass("Humanoid") then
            if v.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local TargetPart = v.Character[AimPart]
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(TargetPart.Position)

                if OnScreen then
                    local Distance = (Vector2.new(ScreenPos.X, ScreenPos.Y) - MousePos).Magnitude
                    if Distance < ShortestDistance then
                        ShortestDistance = Distance
                        ClosestPlayer = TargetPart
                    end
                end
            end
        end
    end
    return ClosestPlayer
end

-- ล็อกเป้าอัตโนมัติเมื่อกดคลิกขวาค้างไว้
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == AimKey and AimEnabled then
        local Target = GetClosestPlayer()
        while UserInputService:IsMouseButtonPressed(AimKey) and AimEnabled do
            task.wait()
            if Target and Target.Parent and Target.Parent:FindFirstChildOfClass("Humanoid") and Target.Parent:FindFirstChildOfClass("Humanoid").Health > 0 then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, Target.Position), Sensitivity)
            else
                Target = GetClosestPlayer()
            end
        end
    end
end)
